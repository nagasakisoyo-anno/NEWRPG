# 可选：复制为 .env 填写。.env 已被 gitignore，不会进版本库。
#
# 读取优先级：真实环境变量 > .env 文件
# 也就是说，如果系统里已经设了 DEEPSEEK_API_KEY，这里的值不会生效。
# 查看实际生效的来源：启动服务时看 [config] 那一行。
#
# 直接设环境变量（推荐，本项目当前就是这么配的）：
#   $env:DEEPSEEK_API_KEY = "sk-..."                                    # 当前终端
#   [Environment]::SetEnvironmentVariable("DEEPSEEK_API_KEY","sk-...","User")  # 永久

DEEPSEEK_API_KEY=sk-your-key-here

# ---- 可选 ----
# TRPG_MODEL=deepseek-chat             # 模型名
# TRPG_BASE_URL=https://api.deepseek.com
# TRPG_CONFIG=config.yaml              # 角色卡路径
# TRPG_DEBUG=1                         # 开启管线调试日志
# TRPG_API_TOKEN=                      # 设置后所有 API 需 Bearer Token（前端用 VITE_API_TOKEN）
# TRPG_CORS_ORIGINS=*                  # 允许的来源，逗号分隔
# HF_ENDPOINT=https://hf-mirror.com    # 向量模型下载镜像
